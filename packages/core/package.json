{
  "name": "@vela-rbxts/core",
  "version": "0.4.2",
  "type": "module",
  "description": "Semantic boundary and supported Roblox host element contracts for vela-rbxts.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "astra-void",
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "tailwind",
    "tailwindcss",
    "vela",
    "classname",
    "core"
  ],
  "homepage": "https://github.com/astra-void/vela-rbxts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/vela-rbxts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/astra-void/vela-rbxts/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@vela-rbxts/config": "workspace:*",
    "@vela-rbxts/ir": "workspace:*"
  }
}
