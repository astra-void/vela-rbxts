{
  "name": "vela-rbxts",
  "version": "0.13.0",
  "type": "module",
  "description": "Tailwind-style className support for roblox-ts React UI.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "astra-void",
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "tailwind",
    "tailwindcss",
    "vela",
    "classname",
    "react",
    "ui",
    "transformer"
  ],
  "homepage": "https://docs.astra-void.xyz/vela-rbxts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/vela-rbxts.git",
    "directory": "packages/vela-rbxts"
  },
  "bugs": {
    "url": "https://github.com/astra-void/vela-rbxts/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vela": "./dist/cli/index.js",
    "vela-rbxts": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "transformer",
    "schema.json",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transformer": {
      "types": "./dist/transformer.d.cts",
      "import": "./dist/transformer.cjs",
      "require": "./dist/transformer.cjs",
      "default": "./dist/transformer.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types",
    "build:types": "tsc -b tsconfig.json",
    "dev": "tsc -b tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@rbxts/vela-runtime": "workspace:*",
    "@rbxts/vela-runtime-vide": "workspace:*",
    "@vela-rbxts/config": "workspace:*",
    "@vela-rbxts/rbxtsc-host": "workspace:*",
    "@vela-rbxts/types": "workspace:*"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/react": "^17.3.7-ts.1",
    "@rbxts/types": "^1.0.935",
    "roblox-ts": "^3.0.0"
  }
}
