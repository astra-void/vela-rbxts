{
	"name": "@rbxts/vela-runtime-core",
	"version": "0.13.0",
	"description": "The framework-neutral half of the vela-rbxts runtime: class resolution, theme normalization, rem math and value parsing. Installed as a dependency of the host runtime a project's UI library needs.",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"out",
		"default.project.json"
	],
	"license": "MIT",
	"author": "astra-void",
	"keywords": [
		"roblox",
		"roblox-ts",
		"rbxts",
		"tailwind",
		"tailwindcss",
		"vela",
		"classname",
		"runtime"
	],
	"homepage": "https://docs.astra-void.xyz/vela-rbxts/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/vela-rbxts.git",
		"directory": "packages/runtime-core"
	},
	"bugs": {
		"url": "https://github.com/astra-void/vela-rbxts/issues"
	},
	"scripts": {
		"prebuild": "node ./scripts/materialize-config-defaults.cjs && node ../../scripts/rbxts-modules/materialize.cjs",
		"build": "rbxtsc -p tsconfig.json",
		"postbuild": "node ../../scripts/rbxts-modules/clean.cjs",
		"pretypecheck": "node ./scripts/materialize-config-defaults.cjs && node ../../scripts/rbxts-modules/materialize.cjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --fix --unsafe",
		"clean": "node -e \"const fs=require('node:fs');fs.rmSync('out',{recursive:true,force:true});\""
	},
	"dependencies": {
		"@rbxts/services": "^1.6.0"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.935",
		"roblox-ts": "^3.0.0",
		"typescript": "5.9.3"
	}
}
