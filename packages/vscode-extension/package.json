{
	"name": "vela-rbxts-lsp",
	"version": "0.4.2",
	"private": true,
	"type": "commonjs",
	"displayName": "Vela LSP",
	"description": "VS Code extension that launches the standalone Vela RBXTS Rust LSP.",
	"license": "MIT",
	"author": "astra-void",
	"keywords": [
		"roblox",
		"roblox-ts",
		"rbxts",
		"tailwind",
		"tailwindcss",
		"vela",
		"classname",
		"lsp",
		"language-server"
	],
	"homepage": "https://github.com/astra-void/vela-rbxts#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/vela-rbxts.git",
		"directory": "packages/vscode-extension"
	},
	"bugs": {
		"url": "https://github.com/astra-void/vela-rbxts/issues"
	},
	"publisher": "astra-void",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"icon": "icon.png",
	"main": "./dist/extension.js",
	"engines": {
		"vscode": "^1.91.0"
	},
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:typescriptreact"
	],
	"contributes": {
		"configuration": {
			"title": "vela-rbxts",
			"properties": {
				"velaRbxts.lsp.serverPath": {
					"type": "string",
					"default": "",
					"description": "Optional path to the standalone vela-rbxts LSP executable. When empty, the extension uses the published @vela-rbxts/lsp wrapper package when its matching platform binary dependency is installed."
				},
				"velaRbxts.lsp.trace.server": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"description": "Trace level forwarded to the vela-rbxts language client."
				},
				"velaRbxts.lsp.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable the standalone vela-rbxts Rust LSP integration for TypeScript and TSX files."
				}
			}
		}
	},
	"scripts": {
		"build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --external:vscode-languageclient --external:vscode-languageclient/* --external:typescript --outfile=dist/extension.js --sourcemap",
		"dev": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --external:vscode-languageclient --external:vscode-languageclient/* --external:typescript --outfile=dist/extension.js --sourcemap --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check src",
		"clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\"",
		"vscode:prepublish": "pnpm run build",
		"package:vsix": "pnpm run clean && pnpm run build && node ./scripts/package-vsix.cjs",
		"publish:vsix": "node ./scripts/publish-vsix.cjs"
	},
	"dependencies": {
		"@vela-rbxts/lsp": "workspace:*",
		"vscode-languageclient": "^10.1.0"
	},
	"devDependencies": {
		"@vela-rbxts/rbxtsc-host": "workspace:*",
		"esbuild": "^0.28.1",
		"@vscode/vsce": "^3.9.2",
		"@types/node": "^24.10.1",
		"@types/vscode": "^1.91.0",
		"typescript": "5.9.3"
	}
}
