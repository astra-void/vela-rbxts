{
  "name": "@vela-rbxts/rbxtsc-host",
  "version": "0.5.0",
  "type": "commonjs",
  "description": "roblox-ts host adapter that bridges the vela-rbxts compiler into the rbxtsc transform pipeline.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "astra-void",
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "tailwind",
    "tailwindcss",
    "vela",
    "classname",
    "transformer",
    "rbxtsc"
  ],
  "homepage": "https://github.com/astra-void/vela-rbxts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/vela-rbxts.git",
    "directory": "packages/rbxtsc-host"
  },
  "bugs": {
    "url": "https://github.com/astra-void/vela-rbxts/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@vela-rbxts/compiler": "workspace:*",
    "@vela-rbxts/config": "workspace:*",
    "@vela-rbxts/ir": "workspace:*",
    "@vela-rbxts/types": "workspace:*"
  }
}
