{
  "name": "@vela-rbxts/compiler-wasm",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "description": "WebAssembly build of the vela-rbxts compiler, for hosts that cannot load the native addon.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "astra-void",
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "tailwind",
    "tailwindcss",
    "vela",
    "classname",
    "compiler",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/astra-void/vela-rbxts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/vela-rbxts.git",
    "directory": "packages/compiler-wasm"
  },
  "bugs": {
    "url": "https://github.com/astra-void/vela-rbxts/issues"
  },
  "main": "./dist/vela_compiler.js",
  "types": "./dist/vela_compiler.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/vela_compiler.js",
    "dist/vela_compiler.d.ts",
    "dist/vela_compiler_bg.wasm",
    "dist/vela_compiler_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/vela_compiler.d.ts",
      "default": "./dist/vela_compiler.js"
    },
    "./vela_compiler_bg.wasm": "./dist/vela_compiler_bg.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build-wasm.js",
    "dev": "node ./scripts/build-wasm.js",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\""
  }
}
