{
  "name": "@vela-rbxts/ir",
  "version": "0.5.1",
  "type": "module",
  "description": "Internal shared IR types used by the vela-rbxts compiler pipeline.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "astra-void",
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "tailwind",
    "tailwindcss",
    "vela",
    "classname",
    "ir"
  ],
  "homepage": "https://github.com/astra-void/vela-rbxts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/vela-rbxts.git",
    "directory": "packages/ir"
  },
  "bugs": {
    "url": "https://github.com/astra-void/vela-rbxts/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@vela-rbxts/types": "workspace:*"
  }
}
